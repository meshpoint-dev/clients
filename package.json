{
  "name": "@meshpoint/cli",
  "version": "1.4.0",
  "description": "Meshpoint CLI and harness adapters: shared agent memory for developer teams",
  "keywords": [
    "meshpoint",
    "coding-agents",
    "claude-code",
    "codex",
    "cursor",
    "memory"
  ],
  "license": "MIT",
  "homepage": "https://meshpoint.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meshpoint-dev/clients.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "meshpoint": "dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "prepublishOnly": "npm run check && npm run build"
  },
  "dependencies": {
    "@meshpoint/sdk": "^1.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "4.1.12"
  }
}
